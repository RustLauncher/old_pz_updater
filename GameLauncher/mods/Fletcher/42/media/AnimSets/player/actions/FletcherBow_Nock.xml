<?xml version="1.0" encoding="utf-8"?>
<!-- Fletcher: nocking a bow (the reload): reach to the hip quiver, bring the arrow to the bow, nock it. Replaces vanilla LoadRifleNoMag (bolt action) for bows: FletcherBow=true is one condition more. Speed: FletcherReloadSpeed (Archery, quiver: client/Fletcher/Bow.lua). -->
<animNode>
	<m_Name>FletcherBow_Nock</m_Name>
	<m_AnimName>Fletcher_Bow_Nock</m_AnimName>
	<m_Looped>false</m_Looped>
	<m_BlendTime>0.20</m_BlendTime>
	<m_EarlyTransitionOut>true</m_EarlyTransitionOut>
	<m_SpeedScale>FletcherReloadSpeed</m_SpeedScale>
	<m_SyncTrackingEnabled>false</m_SyncTrackingEnabled>
	<m_Conditions>
		<m_Name>PerformingAction</m_Name>
		<m_Type>STRING</m_Type>
		<m_Value>Reload</m_Value>
	</m_Conditions>
	<m_Conditions>
		<m_Name>WeaponReloadType</m_Name>
		<m_Type>STRING</m_Type>
		<m_Value>boltactionnomag</m_Value>
	</m_Conditions>
	<m_Conditions>
		<m_Name>isLoading</m_Name>
		<m_Type>BOOL</m_Type>
		<m_Value>true</m_Value>
	</m_Conditions>
	<m_Conditions>
		<m_Name>FletcherBow</m_Name>
		<m_Type>STRING</m_Type>
		<m_Value>true</m_Value>
	</m_Conditions>
	<m_Events>
		<m_EventName>playReloadSound</m_EventName>
		<m_Time>Start</m_Time>
		<m_ParameterValue>insertAmmoStart</m_ParameterValue>
	</m_Events>
	<m_Events>
		<m_EventName>loadFinished</m_EventName>
		<m_Time>End</m_Time>
		<m_ParameterValue></m_ParameterValue>
	</m_Events>
</animNode>
