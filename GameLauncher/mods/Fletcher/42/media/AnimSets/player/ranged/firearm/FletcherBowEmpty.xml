<?xml version="1.0" encoding="utf-8"?>
<!-- Fletcher: attacking with an empty bow (the button still down after the shot). Vanilla
     FirearmEmptySingle plays a rifle trigger-click (Bob_AttackRifle_Small) that jerks both arms every
     ~0.8 s: this holds the empty-bow pose still instead (Fletcher_Bow_DryFire, mocap_clips.py), with
     vanilla's events (the empty check, ShotDone, AttackAnim) and no gun click. FletcherBow=true wins. -->
<animNode>
	<m_Name>FletcherBowEmpty</m_Name>
	<m_AnimName>Fletcher_Bow_DryFire</m_AnimName>
	<m_Looped>false</m_Looped>
	<m_BlendTime>0.15</m_BlendTime>
	<m_BlendOutTime>0.15</m_BlendOutTime>
	<m_SyncTrackingEnabled>false</m_SyncTrackingEnabled>
	<m_Conditions>
		<m_Name>RangedWeaponEmpty</m_Name>
		<m_Type>BOOL</m_Type>
		<m_Value>true</m_Value>
	</m_Conditions>
	<m_Conditions>
		<m_Name>FireMode</m_Name>
		<m_Type>STRING</m_Type>
		<m_Value>Single</m_Value>
	</m_Conditions>
	<m_Conditions>
		<m_Name>bDoShove</m_Name>
		<m_Type>BOOL</m_Type>
		<m_Value>false</m_Value>
	</m_Conditions>
	<m_Conditions>
		<m_Name>Weapon</m_Name>
		<m_Type>STRING</m_Type>
		<m_Value>firearm</m_Value>
	</m_Conditions>
	<m_Conditions>
		<m_Name>FletcherBow</m_Name>
		<m_Type>STRING</m_Type>
		<m_Value>true</m_Value>
	</m_Conditions>
	<m_Events>
		<m_EventName>WeaponEmptyCheck</m_EventName>
		<m_TimePc>0.001</m_TimePc>
		<m_ParameterValue></m_ParameterValue>
	</m_Events>
	<m_Events>
		<m_EventName>SetVariable</m_EventName>
		<m_TimePc>0.9</m_TimePc>
		<m_ParameterValue>ShotDone=false</m_ParameterValue>
	</m_Events>
	<m_Events>
		<m_EventName>AttackAnim</m_EventName>
		<m_TimePc>0</m_TimePc>
		<m_ParameterValue>FALSE</m_ParameterValue>
	</m_Events>
	<m_SubStateBoneWeights>
		<boneName>Bip01_Spine1</boneName>
	</m_SubStateBoneWeights>
	<m_SubStateBoneWeights>
		<boneName>Bip01_Neck</boneName>
	</m_SubStateBoneWeights>
	<m_SubStateBoneWeights>
		<boneName>Bip01_BackPack</boneName>
	</m_SubStateBoneWeights>
	<m_SubStateBoneWeights>
		<boneName>Bip01_Prop1</boneName>
	</m_SubStateBoneWeights>
	<m_SubStateBoneWeights>
		<boneName>Bip01_Prop2</boneName>
	</m_SubStateBoneWeights>
	<m_SubStateBoneWeights>
		<boneName>Bip01_Spine</boneName>
		<weight>0.40</weight>
		<includeDescendants>false</includeDescendants>
	</m_SubStateBoneWeights>
	<m_SubStateBoneWeights>
		<boneName>Bip01</boneName>
		<weight>0.20</weight>
		<includeDescendants>false</includeDescendants>
	</m_SubStateBoneWeights>
</animNode>
