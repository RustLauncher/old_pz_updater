<?xml version="1.0" encoding="utf-8"?>
<!-- Fletcher: aiming a bow = holding at full draw (Fletcher_Bow_Hold, a looping tremble). The draw
     itself plays on the way in (IdleFletcherBow's transition), the let-down on the way out. Wins
     over vanilla's aim_rifle (Weapon=firearm) by also requiring FletcherBow=true. -->
<animNode>
	<m_Name>aim_fletcherbow</m_Name>
	<m_AnimName>Fletcher_Bow_Hold</m_AnimName>
	<m_BlendTime>0.20</m_BlendTime>
	<m_SpeedScale>1.00</m_SpeedScale>
	<m_Looped>true</m_Looped>
	<m_maxTorsoTwist>45.00</m_maxTorsoTwist>
	<m_SyncTrackingEnabled>false</m_SyncTrackingEnabled>
	<m_Conditions>
		<m_Name>Weapon</m_Name>
		<m_Type>STRING</m_Type>
		<m_Value>firearm</m_Value>
	</m_Conditions>
	<m_Conditions>
		<m_Name>FletcherBow</m_Name>
		<m_Type>STRING</m_Type>
		<m_Value>true</m_Value>
	</m_Conditions>
	<m_Transitions>
		<m_Target>IdleFletcherBow</m_Target>
		<m_AnimName>Fletcher_Bow_LetDown</m_AnimName>
		<m_blendInTime>0.2</m_blendInTime>
		<m_blendOutTime>0.3</m_blendOutTime>
	</m_Transitions>
	<m_Transitions>
		<m_Target>Idle</m_Target>
		<m_blendInTime>0.3</m_blendInTime>
		<m_blendOutTime>0.3</m_blendOutTime>
	</m_Transitions>
</animNode>
