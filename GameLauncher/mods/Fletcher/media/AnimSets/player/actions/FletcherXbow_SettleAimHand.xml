<?xml version="1.0" encoding="utf-8"?>
<!-- Fletcher: the rack step after cocking the hand crossbow WHILE AIMING. Vanilla RackRifleAimNoMag (rack while aiming) has the same 4 conditions as our settle node, so both ran and BOTH racked: the arrow went on and straight back off. RackAiming + ours = 5 conditions: only this one runs. -->
<animNode>
	<m_Name>FletcherXbow_SettleAimHand</m_Name>
	<m_AnimName>Fletcher_Xbow_Settle</m_AnimName>
	<m_Looped>false</m_Looped>
	<m_BlendTime>0.20</m_BlendTime>
	<m_EarlyTransitionOut>true</m_EarlyTransitionOut>
	<m_SpeedScale>ReloadSpeed</m_SpeedScale>
	<m_SyncTrackingEnabled>false</m_SyncTrackingEnabled>
	<m_Conditions>
		<m_Name>PerformingAction</m_Name>
		<m_Type>STRING</m_Type>
		<m_Value>Reload</m_Value>
	</m_Conditions>
	<m_Conditions>
		<m_Name>WeaponReloadType</m_Name>
		<m_Type>STRING</m_Type>
		<m_Value>boltactionnomag</m_Value>
	</m_Conditions>
	<m_Conditions>
		<m_Name>isRacking</m_Name>
		<m_Type>BOOL</m_Type>
		<m_Value>true</m_Value>
	</m_Conditions>
	<m_Conditions>
		<m_Name>FletcherXbow</m_Name>
		<m_Type>STRING</m_Type>
		<m_Value>Hand</m_Value>
	</m_Conditions>
	<m_Conditions>
		<m_Name>RackAiming</m_Name>
		<m_Type>BOOL</m_Type>
		<m_Value>true</m_Value>
	</m_Conditions>
	<m_Events>
		<m_EventName>rackBullet</m_EventName>
		<m_TimePc>0.30</m_TimePc>
		<m_ParameterValue></m_ParameterValue>
	</m_Events>
	<m_Events>
		<m_EventName>rackingFinished</m_EventName>
		<m_Time>End</m_Time>
		<m_ParameterValue></m_ParameterValue>
	</m_Events>
</animNode>
