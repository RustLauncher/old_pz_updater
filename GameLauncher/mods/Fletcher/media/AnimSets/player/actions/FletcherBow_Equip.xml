<?xml version="1.0" encoding="utf-8"?>
<!-- Fletcher: equipping a bow: off the left shoulder into the bow hand. FletcherEquip is set by client/Fletcher/Bow.lua while an equip / unequip action handles a bow (the bow isn't in hand yet, so FletcherBow can't tell). -->
<animNode>
	<m_Name>FletcherBow_Equip</m_Name>
	<m_AnimName>Fletcher_Bow_Equip</m_AnimName>
	<m_Looped>false</m_Looped>
	<m_BlendTime>0.20</m_BlendTime>
	<m_SpeedScale>1.70</m_SpeedScale>
	<m_SyncTrackingEnabled>false</m_SyncTrackingEnabled>
	<m_Conditions>
		<m_Name>PerformingAction</m_Name>
		<m_Type>STRING</m_Type>
		<m_Value>EquipItem</m_Value>
	</m_Conditions>
	<m_Conditions>
		<m_Name>FletcherEquip</m_Name>
		<m_Type>STRING</m_Type>
		<m_Value>true</m_Value>
	</m_Conditions>
</animNode>
