<?xml version="1.0" encoding="utf-8"?>
<!-- Fletcher: cocking the lever crossbow and laying a bolt (animation/scripts/crossbow_clips.py). Replaces vanilla LoadRifleNoMag (bolt action) for it: FletcherXbow=Lever is one condition more. Speed: FletcherReloadSpeed (client/Fletcher/Bow.lua). -->
<animNode>
	<m_Name>FletcherXbow_CockLever</m_Name>
	<m_AnimName>Fletcher_Xbow_Cock_Lever</m_AnimName>
	<m_Looped>false</m_Looped>
	<m_BlendTime>0.20</m_BlendTime>
	<m_EarlyTransitionOut>true</m_EarlyTransitionOut>
	<m_SpeedScale>FletcherReloadSpeed</m_SpeedScale>
	<m_SyncTrackingEnabled>false</m_SyncTrackingEnabled>
