  fx.1 reveal f_ride
  fx.2 set flag:ride_told
  tag.1 kind:answer
end

node vp_1250.VQ_PAST_FIRSTJOB.d
  t.any.1 Helper for Otis Vale.. carried more than I understood at first
  tag.1 kind:deflect
end

node vp_1250.VQ_PAST_FIRSTJOB.d2
  t.any.1 Started at eighteen.. first day wasn't one worth framing
  tag.1 kind:deflect
end

node vp_1250.VQ_PAST_HOBBY
  t.any.1 Canning.. jar mouths have to be clean before I can stop fussing
  t.any.2 Worked on the motorcycle too.. canning gave us more things we could actually use
  tag.1 kind:answer
end

node vp_1250.VQ_PAST_HOUSE
  t.any.1 Rented room.. boots at one end, motorcycle bits at the other
  t.any.2 Near Dee and Brent.. could hear their gate before my own alarm
  tag.1 kind:answer
end

node vp_1250.VQ_PAST_LASTNORMAL
