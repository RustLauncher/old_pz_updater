  tag.1 kind:react
end

node vp_1228.react.gave_food
  t.any.1 Food first.. can stop pretending the scorecard deserves all my attention
  tag.1 kind:react
end

node vp_1228.react.gave_water
  t.any.1 Mine to finish.. don't need Grandma's red cup to recognize a drink anymore
  tag.1 kind:react
end

node vp_1228.react.ignored
  t.any.1 Still here with the notebook.. you waiting for Mom to ask instead?
  tag.1 kind:react
end

node vp_1228.react.insult
  t.any.1 That's an insult, not a rule.. Grandma could tell the difference too
  tag.1 kind:react
end

