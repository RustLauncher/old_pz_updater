#version 110

// Trailer Cargo: damage marks over a damaged part of a car on a car
// trailer. GENERATED by build/gen_car_shaders.py, swatch hue07_dark. The car's
// damage shell texture through the second UV set, recoloured like
// vanilla's addDamage (vehicle_common.frag.glsl), only where marked.

varying vec2 texCoords;

uniform sampler2D Texture;
uniform float Alpha;

const vec3 PAINT = vec3(0.5833, 0.6700, 0.4000);

vec3 rgb2hsv(vec3 c)
{
    vec4 K = vec4(0.0, -1.0 / 3.0, 2.0 / 3.0, -1.0);
    vec4 p = mix(vec4(c.bg, K.wz), vec4(c.gb, K.xy), step(c.b, c.g));
    vec4 q = mix(vec4(p.xyw, c.r), vec4(c.r, p.yzx), step(p.x, c.r));
    float d = q.x - min(q.w, q.y);
    float e = 1.0e-10;
    return vec3(abs(q.z + (q.w - q.y) / (6.0 * d + e)), d / (q.x + e), q.x);
}

vec3 hsv2rgb(vec3 c)
{
    vec4 K = vec4(1.0, 2.0 / 3.0, 1.0 / 3.0, 3.0);
    vec3 p = abs(fract(c.xxx + K.xyz) * 6.0 - K.www);
    return c.z * mix(K.xxx, clamp(p - K.xxx, 0.0, 1.0), c.y);
}


void main()
{
    vec4 d = texture2D(Texture, texCoords);
    float a = d.a * 0.75 * Alpha;
    if (a < 0.03) discard;
    vec3 hsv = rgb2hsv(d.rgb);
    hsv.x = PAINT.x;
    hsv.y = clamp(hsv.y + PAINT.y - 0.5, 0.0, 0.9999);
    hsv.z = clamp(hsv.z + PAINT.z - 0.5, 0.0, 0.9999);
    hsv = mod(hsv, 1.0);
    gl_FragColor = vec4(hsv2rgb(hsv), a);
}
